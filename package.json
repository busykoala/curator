{
  "name": "music-curator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && npm run build:workers",
    "build:workers": "esbuild src/worker.ts src/acquisition-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=.workers --out-extension:.js=.mjs",
    "start": "node scripts/start.mjs",
    "web": "next start -H 0.0.0.0 -p 3000",
    "worker": "tsx src/worker.ts",
    "sample": "tsx src/cli/sample.ts",
    "audit:categorization": "tsx src/cli/audit-categorization.ts"
    ,"audit:acquisition": "tsx scripts/audit-acquisition.ts && tsx scripts/audit-acquisition-search.ts && tsx scripts/audit-manual-import.ts && tsx scripts/audit-discovery-identity.ts"
    ,"evaluate:ai": "tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "taglib-wasm": "2.2.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
